# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./litlingua.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Configuration
TESSERACT_PATH=/usr/bin/tesseract
MODEL_CACHE_DIR=./backend/data/offline_models

# Optional: OpenAI API for translation enhancement (leave empty for offline mode)
OPENAI_API_KEY=

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./backend/static/uploaded_files

# Audio Configuration
TTS_ENGINE=gtts
AUDIO_OUTPUT_DIR=./backend/static/audio

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Feature Flags
ENABLE_RETRAINING=True
ENABLE_OFFLINE_MODE=True
ENABLE_VOICE_INPUT=True
